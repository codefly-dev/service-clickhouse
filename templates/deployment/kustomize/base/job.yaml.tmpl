apiVersion: batch/v1
kind: Job
metadata:
  # Content-addressed (bootstrapJobName in builder.go): the service name plus a
  # digest of the pod template below, so a changed migration image -- a changed
  # migration set -- or a changed address or credential reference names a NEW
  # Job, which runs, while an unchanged render names the same one. A Job's pod
  # template is immutable, so a fixed name could never carry a change.
  name: {{ .Deployment.Parameters.BootstrapJobName }}
  namespace: {{ .Namespace }}
spec:
  # No ttlSecondsAfterFinished: the completed Job stays, so the manifest that
  # declares it stays in sync and its outcome stays observable. A TTL deletes
  # the declared object and leaves a reconciler reporting it missing forever.
  backoffLimit: 4
  template:
    metadata:
      annotations:
        sidecar.istio.io/inject: "false"
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: {{ .Service.Name.DNSCase }}
          image: {{ .Image }}
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 65534
            runAsGroup: 65534
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
{{- $address := .Deployment.Parameters.MigrationAddressKey }}
{{- $references := and .Restricted .SecretReferences }}
{{- if or $address $references }}
          env:
{{- end }}
{{- if $address }}
            # The database this Job migrates against. The entrypoint composes
            # the migrate URL from this address plus the credentials below, so
            # the address has ONE source -- the in-cluster instance core handed
            # the tcp endpoint, the same one the Service publishes (see
            # service.yaml) -- and is never typed into the image. Without it
            # the entrypoint has no URL at all and exits before migrating. A
            # Deploy that cannot resolve that instance is refused by name
            # (builder.go), so only a parameter-free template render omits it.
            - name: {{ $address }}
              value: "{{ .Deployment.Parameters.MigrationAddress }}"
{{- end }}
{{- if $references }}
{{- range $name, $reference := .SecretReferences }}
            - name: {{ $name }}
              valueFrom:
                secretKeyRef:
                  name: {{ $reference.Name }}
                  key: {{ $reference.Key }}
                  optional: {{ $reference.Optional }}
{{- end }}
{{- end }}
{{- if not .Restricted }}
          envFrom:
            - secretRef:
                name: secret-{{ .Service.Name.DNSCase }}
{{- end }}
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
      restartPolicy: Never
