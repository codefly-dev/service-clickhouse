apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: "{{ .Namespace }}"
spec:
  serviceName: {{ .Service.Name.DNSCase }}
  replicas: 1
  selector:
    matchLabels:
      app: {{ .Service.Name.DNSCase }}
  template:
    metadata:
      labels:
        app: {{ .Service.Name.DNSCase }}
    spec:
      automountServiceAccountToken: false
      # uid/gid 101 = the `clickhouse` user/group in the official image — needed
      # so the server can write to the PV (otherwise it is owned by root:root and
      # startup fails). seccomp RuntimeDefault picks up the kernel's default
      # syscall filter; the restrictive PSS profile mandates setting it explicitly.
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        fsGroup: 101
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 60
      containers:
        - name: clickhouse
          # Supplied by main.go's managed-image declaration (or the service
          # override), including its digest when one is configured.
          image: {{ .Deployment.Parameters.ManagedImage }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 101
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          ports:
            - name: native
              containerPort: 9000
            - name: http
              containerPort: 8123
{{- $server := .Deployment.Parameters.Server }}
{{- $user := and $server.UserVariable $server.User }}
{{- $password := and $server.PasswordVariable $server.Password }}
{{- $references := and .Restricted .SecretReferences }}
{{- if or $server.DatabaseVariable $server.AlwaysInitVariable $user $password $references }}
          env:
{{- end }}
{{- if $server.DatabaseVariable }}
            # What the IMAGE reads to bootstrap itself. A codefly carrier names
            # a module and a service, which clickhouse knows nothing about, so
            # the engine parses none of them: given only those, it comes up on
            # its built-in `default` user and never creates this service's
            # database, and the connection every consumer is handed -- and the
            # bootstrap Job's -- is accepted by no server.
            - name: {{ $server.DatabaseVariable }}
              value: "{{ $server.Database }}"
{{- end }}
{{- if $server.AlwaysInitVariable }}
            # The entrypoint creates that database only while the data
            # directory is empty; this forces the step on every start, so an
            # already-initialized volume gets it too. Nothing is mounted at
            # /docker-entrypoint-initdb.d, so `CREATE DATABASE IF NOT EXISTS`
            # is all it re-runs -- the same step the nix runtime takes on every
            # Init.
            - name: {{ $server.AlwaysInitVariable }}
              value: "1"
{{- end }}
{{- if $user }}
            # A restricted render carries no secret value, so the credentials
            # are the references the host declared for this service's own
            # clickhouse carriers, aliased here under the names the image
            # reads. The entrypoint rewrites users.d from them on every start.
            - name: {{ $server.UserVariable }}
              valueFrom:
                secretKeyRef:
                  name: {{ $server.User.Name }}
                  key: {{ $server.User.Key }}
                  optional: {{ $server.User.Optional }}
{{- end }}
{{- if $password }}
            - name: {{ $server.PasswordVariable }}
              valueFrom:
                secretKeyRef:
                  name: {{ $server.Password.Name }}
                  key: {{ $server.Password.Key }}
                  optional: {{ $server.Password.Optional }}
{{- end }}
{{- if $references }}
{{- range $name, $reference := .SecretReferences }}
            - name: {{ $name }}
              valueFrom:
                secretKeyRef:
                  name: {{ $reference.Name }}
                  key: {{ $reference.Key }}
                  optional: {{ $reference.Optional }}
{{- end }}
{{- end }}
{{- if not .Restricted }}
          # The same Secret carries the credentials under the image's names.
          envFrom:
            - secretRef:
                name: secret-{{ .Service.Name.DNSCase }}
{{- end }}
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 4Gi
          # The HTTP /ping endpoint is clickhouse's canonical "am I up" check —
          # it returns "Ok.\n" only once the server is accepting connections.
          #   startup:   grants up to 60s for first-boot init (+ migrations).
          #   readiness: pulls the pod from the Service if it stalls.
          #   liveness:  restarts only on hard hangs.
          startupProbe:
            httpGet:
              path: /ping
              port: 8123
            periodSeconds: 5
            failureThreshold: 12
          readinessProbe:
            httpGet:
              path: /ping
              port: 8123
            periodSeconds: 10
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /ping
              port: 8123
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          volumeMounts:
            - name: clickhouse-data
              mountPath: /var/lib/clickhouse
              subPath: chdata
            - name: clickhouse-log
              mountPath: /var/log/clickhouse-server
            - name: clickhouse-users
              mountPath: /etc/clickhouse-server/users.d
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: clickhouse-log
          emptyDir: {}
        - name: clickhouse-users
          emptyDir: {}
        - name: tmp
          emptyDir: {}
  volumeClaimTemplates:
    - metadata:
        name: clickhouse-data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 20Gi
