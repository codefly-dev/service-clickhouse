apiVersion: v1
kind: Service
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: "{{ .Namespace }}"
spec:
  selector:
    app: {{ .Service.Name.DNSCase }}
  ports:
    - name: native
      port: 9000
      targetPort: 9000
    - name: http
      port: 8123
      targetPort: 8123
  # Headless — clients reach clickhouse via the StatefulSet pod's stable DNS
  # (<svc>-0.<svc>.<ns>.svc). For a managed ClickHouse Cloud deployment, replace
  # this kustomize layer with an ExternalName Service in the module overlay.
  clusterIP: None
