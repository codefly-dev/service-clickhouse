# Base pinned by digest: a render binds an image's identity by resolving its
# bases' manifests; pinned, no registry read is spent (a throttled Docker Hub
# otherwise rebuilt unchanged images), and two builders cannot bake two bases
# under one tag. Move the pin on purpose. alpine:3.21 as of 2026-10-17.
FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507

WORKDIR /app

ARG TARGETARCH
RUN apk add --no-cache curl
# The release this agent links for its own in-process migrations (go.mod), so
# the CLI cannot drift from it again.
RUN curl -fsSL https://github.com/golang-migrate/migrate/releases/download/{{ .MigrateVersion }}/migrate.linux-${TARGETARCH}.tar.gz | tar xz
RUN mv migrate /usr/local/bin/migrate

COPY . .

COPY migrations /app/migrations

# The entrypoint BUILDS the database URL; it is never handed one. The address
# comes from the single variable the deploy sets on the bootstrap Job -- the
# in-cluster instance core handed this endpoint, which is the address the
# Service publishes and every consumer dials -- and the credentials from the
# Secret the Job already reads. So the address has one source, the render, and
# a restricted render still carries no secret value.
#
# The query form is not cosmetic: clickhouse-go v1, the driver behind the
# migrate CLI's clickhouse:// scheme, reads username/password/database from the
# QUERY and ignores URL userinfo, so the consumer form this service exports
# (clickhouse://user:pass@host/db) would silently authenticate as `default`.
# x-multi-statement matches the agent's own in-process migration, so a
# migration that applies under `codefly run` applies here too. The database is
# this service's own setting, baked in at build time like the migrations.
#
# A missing variable is refused BY NAME before migrate runs: this regression
# reached a cluster as migrate's own `URL cannot be empty`, which names nothing.
#
# Everything migrate prints passes through a redaction filter before it reaches
# the Job's log, because migrate's errors can quote the URL it was handed:
# v4.18.1 quoted it on every failed connection, and the clickhouse driver still
# returns net/url's parse error, which quotes the whole URL. The filter replaces
# the password itself, wherever it appears, and any `password=` query value. The
# exit status is migrate's, carried past the pipe on fd 3 (POSIX sh has no
# pipefail), so a failed migration still fails the Job.
CMD if [ -z "${{ .AddressKey }}" ] || [ -z "${{ .UserKey }}" ] || [ -z "${{ .PasswordKey }}" ]; then \
      echo "the bootstrap Job must carry {{ .AddressKey }}, {{ .UserKey }} and {{ .PasswordKey }}" >&2; \
      exit 1; \
    fi; \
    status=$( { { /usr/local/bin/migrate -path /app/migrations \
      -database "clickhouse://${{ .AddressKey }}?username=${{ .UserKey }}&password=${{ .PasswordKey }}&database={{ .DatabaseName }}&x-multi-statement=true" up 2>&1; \
      echo $? >&3; } | awk '{ \
        secret = ENVIRON["{{ .PasswordKey }}"]; line = $0; out = ""; \
        while (secret != "" && (i = index(line, secret)) > 0) { out = out substr(line, 1, i - 1) "<redacted>"; line = substr(line, i + length(secret)) } \
        line = out line; gsub(/password=[^&"]*/, "password=<redacted>", line); print line; fflush() \
      }' >&2; } 3>&1 ); \
    exit "${status:-1}"
